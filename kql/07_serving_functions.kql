.create-or-alter function 
with (
    folder = "Gold/Serving", 
    docstring = "Operational serving view combining reconstructed state with latest telemetry observation", skipvalidation = "true") 
FleetOperationalView(p_RunId:string) {
    FleetCurrentState(p_RunId)
    | join kind = leftouter LatestTelemetryObservation(p_RunId) on simulator_run_id, drone_id, battalion_id, mission_id
    | extend telemetry_state_gap_ms = datetime_diff("millisecond", state_as_of, telemetry_as_of)
    | project
            simulator_run_id, drone_id, battalion_id, mission_id, 
            asset_state, connection_state,
            mission_phase, mission_status, platform_health, 
            latitude, longitude, altitude_m, ground_speed_mps, vertical_speed_mps, heading_deg,
            battery_pct, communication_mode, optic_fiber_remaining_m,
            telemetry_as_of, state_as_of, telemetry_state_gap_ms, telemetry_ingested_at
}

.create-or-alter function 
with (
    folder = "Gold/Serving", 
    docstring = "Fleet-level operational KPIs derived from the Gold operational view", 
    skipvalidation = "true") 
FleetOperationalSummary(p_RunId:string) {
    FleetOperationalView(p_RunId)
    | summarize
        TotalDrones = count(),
        // Communication modes
        RfDrones = countif(communication_mode == "RF"),
        FiberDrones = countif(communication_mode == "FIBER"),
        UnknownCommunicationModeDrones = countif(isempty(communication_mode)),
        // Operational state
        AvailableDrones = countif(asset_state == "AVAILABLE"),
        ConnectedDrones = countif(connection_state == "CONNECTED"),
        CompletedMissions = countif(mission_status == "COMPLETED"),
        HealthyDrones = countif(platform_health == "NORMAL"),
        // Terminal state
        DestroyedDrones = countif(asset_state == "DESTROYED"),
        AbortedMissions = countif(mission_status == "ABORTED"),
        TerminalAssets = countif(asset_state == "DESTROYED" or mission_status == "ABORTED"),
        // Consumables / health
        AvgBatteryPct = avg(battery_pct),
        MinBatteryPct = min(battery_pct),
        AvgOpticFiberRemainingM = avgif(optic_fiber_remaining_m, communication_mode == "FIBER"),
        MinOpticFiberRemainingM = minif(optic_fiber_remaining_m, communication_mode == "FIBER"),
        LatestStateAsOf = max(state_as_of),
        LatestTelemetryAsOf = max(telemetry_as_of)
    | extend
        AvailabilityPct = round(100.0 * todouble(AvailableDrones) / TotalDrones,1),
        ConnectivityPct = round(100.0 * todouble(ConnectedDrones) / TotalDrones, 1),
        MissionCompletionPct = round(100.0 * todouble(CompletedMissions) / TotalDrones, 1),
        HealthyPct = round(100.0 * todouble(HealthyDrones) / TotalDrones, 1),
        CommunicationModeCoveragePct = round(100.0 * todouble(RfDrones + FiberDrones) / TotalDrones, 1),
        AssetLossPct = round(100.0 * todouble(DestroyedDrones) / TotalDrones, 1)
    | project
        TotalDrones,
        RfDrones,
        FiberDrones,
        UnknownCommunicationModeDrones,
        CommunicationModeCoveragePct,
        AvailableDrones,
        AvailabilityPct,
        ConnectedDrones,
        ConnectivityPct,
        CompletedMissions,
        MissionCompletionPct,
        HealthyDrones,
        HealthyPct,
        DestroyedDrones,
        AbortedMissions,
        TerminalAssets,
        AssetLossPct,
        AvgBatteryPct,
        MinBatteryPct,
        AvgOpticFiberRemainingM,
        MinOpticFiberRemainingM,
        LatestStateAsOf,
        LatestTelemetryAsOf
}

.create-or-alter function 
with (
    folder = "Gold/Serving", 
    docstring = "Most recently observed simulator run based on Event Hubs enqueue time", 
    skipvalidation = "true") 
LatestObservedRun() {
    RawDroneEvents
    | summarize 
        LastSeenAt = max(eh_enqueued_time),
        Events = count()
    by RunId = tostring(simulation.simulator_run_id)
    | top 1 by LastSeenAt desc
}

.create-or-alter function 
with (
    folder = "Gold/Serving", 
    docstring = "Operational view for the most recently observed simulator run", 
    skipvalidation = "true") 
CurrentFleetOperationalView() {
    let RunId = toscalar(LatestObservedRun() | project RunId);
    FleetOperationalView(RunId)
}

.create-or-alter function 
with (
    folder = "Gold/Serving", 
    docstring = "Fleet-level KPIs for the most recently observed simulator run", 
    skipvalidation = "true") 
CurrentFleetOperationalSummary() {
    let RunId = toscalar(LatestObservedRun() | project RunId);
    FleetOperationalSummary(RunId)
}

.create-or-alter function 
with (
    folder = "Gold/Serving", 
    docstring = "Current geospatial operational serving dataset for fleet visualization", 
    skipvalidation = "true") 
CurrentFleetMapView() {
    CurrentFleetOperationalView()
    | extend telemetry_age_ms = datetime_diff("millisecond", now(), telemetry_ingested_at)
    | extend telemetry_age_sec = round(todouble(telemetry_age_ms) / 1000.0, 1)
    | extend
        operational_condition =
            case(
                asset_state == "DESTROYED", "DESTROYED",
                mission_status == "ABORTED", "MISSION ABORTED",
                connection_state != "CONNECTED", "DISCONNECTED",
                mission_status == "COMPLETED", "MISSION COMPLETED",
                mission_status == "ACTIVE", "MISSION ACTIVE",
                "OTHER"
            )
    | project 
        drone_id,
        battalion_id,
        mission_id,
        latitude,
        longitude,
        altitude_m,
        heading_deg,
        ground_speed_mps,
        vertical_speed_mps,
        battery_pct,
        communication_mode,
        optic_fiber_remaining_m,
        asset_state,
        connection_state,
        mission_phase,
        mission_status,
        platform_health,
        operational_condition,
        telemetry_as_of,
        telemetry_ingested_at,
        telemetry_age_sec,
        state_as_of
    | order by drone_id asc
}

.create-or-alter function
with (
    folder = "Gold/Serving",
    docstring = "Terminal fleet assets with last-known telemetry position and reconciled operational state",
    skipvalidation = "true"
)
CurrentTerminalAssetsView() {
    CurrentFleetMapView()
    | where
        asset_state == "DESTROYED" or mission_status == "ABORTED"
    | extend
        terminal_condition =
            case(
                asset_state == "DESTROYED", "DESTROYED",
                mission_status == "ABORTED", "MISSION ABORTED",
                "TERMINAL"
            )
    | project
        drone_id,
        terminal_condition,
        asset_state,
        mission_status,
        mission_phase,
        connection_state,
        communication_mode,
        latitude,
        longitude,
        altitude_m,
        battery_pct,
        optic_fiber_remaining_m,
        telemetry_as_of,
        state_as_of,
        telemetry_age_sec
    | order by state_as_of desc
}

.create-or-alter function
with (
    folder = "Gold/Serving",
    docstring = "Current per-drone communication health and delivery-order diagnostics",
    skipvalidation = "true")
CurrentCommunicationHealthView() {
    let LatestRun = toscalar(LatestObservedRun() | project RunId);
    // -----------------------------------------------------
    // Current communication state from reconciled serving.
    // -----------------------------------------------------
    let CurrentState =
        CurrentFleetOperationalView()
        | project drone_id, communication_mode, connection_state, optic_fiber_remaining_m, telemetry_as_of, state_as_of;
    // -----------------------------------------------------
    // First physical observation of each logical event.
    // Deduplication here prevents downstream redelivery
    // from being misclassified as delivery disorder.
    // -----------------------------------------------------
    let FirstDelivery =
        RawDroneEvents
        | where tostring(simulation.simulator_run_id) == LatestRun
        | extend raw_ingested_at = ingestion_time()
        | summarize arg_min(raw_ingested_at, *)
        by event_id
        | project 
            drone_id = tostring(drone_id),
            source_sequence_number = tolong(source_sequence_number),
            eh_sequence_number = tolong(eh_sequence_number),
            event_time = todatetime(event_time),
            eh_enqueued_time;
    // -----------------------------------------------------
    // Detect delivery-order inversions independently for each producer.
    // -----------------------------------------------------
    let DeliveryDiagnostics =
        FirstDelivery
        | sort by drone_id asc, eh_sequence_number asc
        | serialize
        | extend 
            PrevDrone = prev(drone_id),
            PrevSourceSequence = prev(source_sequence_number),
            RelativeDelayMs = datetime_diff("millisecond", eh_enqueued_time, event_time)
        | extend
            IsOutOfOrder = PrevDrone == drone_id and source_sequence_number < PrevSourceSequence            
        | summarize
            OutOfOrderEvents = countif(IsOutOfOrder),
            MaxRelativeDelayMs = max(RelativeDelayMs)
        by drone_id;
    CurrentState
    | join kind = leftouter DeliveryDiagnostics on drone_id
    | extend OutOfOrderEvents = coalesce(OutOfOrderEvents, 0)
    | extend
        communication_condition =
            case(
                connection_state != "CONNECTED", "DISCONNECTED", 
                OutOfOrderEvents > 0, "DELIVERY DISORDER",
                "HEALTHY"
            )
    | project
        drone_id,
        communication_mode,
        communication_condition,
        connection_state,
        OutOfOrderEvents,
        MaxRelativeDelayMs,
        optic_fiber_remaining_m,
        telemetry_as_of,
        state_as_of
    | order by
        communication_condition desc,
        drone_id asc
}

.create-or-alter function
with (
    folder = "Gold/Serving",
    docstring = "Current fleet-level communication health KPIs",
    skipvalidation = "true")
CurrentCommunicationHealthSummary() {
    CurrentCommunicationHealthView()
    | summarize
        TotalDrones             = count(),
        RfDrones                = countif(communication_mode == "RF"),
        FiberDrones             = countif(communication_mode == "FIBER"),
        HealthyLinks            = countif(communication_condition == "HEALTHY"),
        DeliveryDisorderLinks   = countif(communication_condition == "DELIVERY DISORDER"),
        DisconnectedLinks       = countif(communication_condition == "DISCONNECTED"),
        AffectedLinks           = countif(communication_condition != "HEALTHY"),
        OutOfOrderEvents        = sum(OutOfOrderEvents),
        MaxRelativeDelayMs      = max(MaxRelativeDelayMs)
    | extend 
        HealthyLinksPct = round(100.0 * todouble(HealthyLinks) / TotalDrones, 1),
        AffectedLinksPct        = round(100.0 * todouble(AffectedLinks) / TotalDrones, 1)
}

.create-or-alter function
with (
    folder = "Gold/Serving",
    docstring = "Current-run communication link state transition events",
    skipvalidation = "true"
)
CurrentLinkStateEventsView() {
    let RunId = toscalar(LatestObservedRun() | project RunId);
    let CommunicationModes = CurrentFleetOperationalView() | project drone_id, communication_mode;
    StateTransitionsCanonical
    | where simulator_run_id == RunId and state_domain == "connection_state"
    | join kind = leftouter CommunicationModes on drone_id
    | extend LinkTransition = strcat(previous_state, " → ", new_state)
    | extend LinkEventClass = case(
            new_state == "DISCONNECTED", "LINK DOWN", 
            new_state == "CONNECTED","LINK RESTORED",
            "STATE CHANGE")
    | project drone_id, communication_mode, LinkEventClass, LinkTransition, reason_code, 
        event_time, source_sequence_number
    | order by event_time desc, drone_id asc
}

.create-or-alter function
with (
    folder = "Gold/Serving",
    docstring = "Current-run 10-second arrival-window metrics based on Event Hubs enqueue time",
    skipvalidation = "true"
)
CurrentArrivalWindowMetrics() {
    let RunId = toscalar(LatestObservedRun() | project RunId);
    RawDroneEvents
    | where tostring(simulation.simulator_run_id) == RunId
    | extend
        RawIngestedAt = ingestion_time(),
        RelativeDelayMs = datetime_diff("millisecond", eh_enqueued_time, todatetime(event_time))
    | extend        
        CloudLatencyMs = datetime_diff("millisecond", RawIngestedAt, eh_enqueued_time),
        WindowStart = bin(eh_enqueued_time, 10s)
    | summarize
        DeliveryRows            = count(),
        UniqueEvents            = count_distinct(event_id),
        TelemetryEvents         = countif(event_type == "telemetry"),
        StateTransitionEvents   = countif(event_type == "state_transition"),
        P95RelativeDelayMs      = percentile(RelativeDelayMs, 95),
        MaxRelativeDelayMs      = max(RelativeDelayMs),
        P95CloudLatencyMs       = percentile(CloudLatencyMs, 95),
        MaxCloudLatencyMs       = max(CloudLatencyMs),
        FirstArrival            = min(eh_enqueued_time),
        LastArrival             = max(eh_enqueued_time)
      by WindowStart
    | extend
        WindowEnd               = WindowStart + 10s,
        DuplicateDeliveries     = DeliveryRows - UniqueEvents,
        EventsPerSecond         = round(todouble(DeliveryRows) / 10.0,2)
    | project
        WindowStart, WindowEnd, DeliveryRows, UniqueEvents, DuplicateDeliveries,
        TelemetryEvents, StateTransitionEvents, EventsPerSecond, P95RelativeDelayMs, MaxRelativeDelayMs,
        P95CloudLatencyMs, MaxCloudLatencyMs, FirstArrival, LastArrival
    | order by WindowStart desc 
}