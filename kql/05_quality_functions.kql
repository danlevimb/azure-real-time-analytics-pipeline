.create-or-alter function 
with (
    folder = "Silver/Quality", 
    docstring = "Stream integrity diagnostics for one simulator run", 
    skipvalidation = "true") 
StreamIntegrityReport(p_RunId:string) {
    let RawRun =
        RawDroneEvents
        | where tostring(simulation.simulator_run_id) == p_RunId
        | extend BronzeIngestedAt = ingestion_time();
    let CanonicalRun =
        union 
        (
            TelemetryCanonical
            | where simulator_run_id == p_RunId
            | project drone_id, source_sequence_number, event_id, event_time, event_type = "telemetry"
        ),
        (
            StateTransitionsCanonical
            | where simulator_run_id  == p_RunId
            | project drone_id, source_sequence_number, event_id, event_time, event_type = "state_transition"
        ),    
        (
            MaintenanceEventsCanonical
            | where simulator_run_id == p_RunId
            | project drone_id, source_sequence_number, event_id, event_time, event_type = "maintenance_event"
        ),
        (
            StatusConfirmationsCanonical
            | where simulator_run_id == p_RunId
            | project drone_id, source_sequence_number, event_id, event_time, event_type = "status_confirmation"
        );
    let PhysicalRows = toscalar(RawRun | count);
    let UniqueEventIds = toscalar(RawRun | summarize by event_id | count);
    let DuplicateDeliveries = PhysicalRows - UniqueEventIds;
    let GapStats = 
        CanonicalRun
        | sort by drone_id asc, source_sequence_number asc
        | extend 
            PrevDrone = prev(drone_id),
            PrevSeq = prev(source_sequence_number)
        | where drone_id == PrevDrone
            and source_sequence_number  > PrevSeq  + 1 
        | summarize
            SequenceGaps = count (),
            MissingSequences = sum(source_sequence_number - PrevSeq - 1);
    let SequenceGaps = toscalar(GapStats | project SequenceGaps);
    let MissingSequences = toscalar (GapStats | project MissingSequences);
    let OutOfOrderTransitions = 
        toscalar(
            RawRun
            | sort by drone_id asc, eh_sequence_number asc 
            | extend 
                PrevDrone = prev(drone_id),
                PrevSourceSeq = prev(source_sequence_number)
            | where drone_id == PrevDrone
                and source_sequence_number < PrevSourceSeq
            | count
        );
    let NullEhMetadata = 
        toscalar(
            RawRun
            | where 
                isnull(eh_enqueued_time) or isnull(eh_enqueued_time) or isempty( eh_offset)
            | count
        );
    print 
        RunId = p_RunId,
        PhysicalRows = PhysicalRows,
        UniqueEventIds = UniqueEventIds,
        DuplicateDeliveries = DuplicateDeliveries,
        SequenceGaps = SequenceGaps,
        MissingSequences = MissingSequences,
        OutOfOrderTransitions = OutOfOrderTransitions,
        NullEhMetadata = NullEhMetadata
}

.create-or-alter function 
with (
    folder = "Silver/Quality", 
    docstring = "Stream timeliness diagnostics for one simulator run", 
    skipvalidation = "true") 
StreamTimelinessReport(p_RunId:string) {
    let RawRun =
    RawDroneEvents
    | where tostring( simulation.simulator_run_id) == p_RunId
    | extend BronzeIngestedAt = ingestion_time();
    let BaseLine = 
        RawRun
        | summarize 
            FirstEventTime = min(event_time),
            FirstEhTime = min(eh_enqueued_time)
         by drone_id;
    let TimedRun = 
        RawRun
        | join kind= inner BaseLine on drone_id
        | extend
            SourceElapsedMs = datetime_diff("millisecond", event_time, FirstEventTime),
            EhElapsedMs = datetime_diff("millisecond", eh_enqueued_time, FirstEhTime)
        | extend 
            RelativeDelayMs = EhElapsedMs - SourceElapsedMs,
            CloudLatencyMs = datetime_diff("millisecond", BronzeIngestedAt, eh_enqueued_time);
    let DelayStats = 
        TimedRun
        | summarize 
            Events = count(),
            P50RelativeDelayMs = percentile(RelativeDelayMs, 50),
            P95RelativeDelayMs = percentile(RelativeDelayMs, 95),
            P99RelativeDelayMs = percentile(RelativeDelayMs, 99),
            MaxRelativeDelayMs = max(RelativeDelayMs),
            P50CloudLatencyMs = percentile(CloudLatencyMs, 50),
            P95CloudLatencyMs = percentile(CloudLatencyMs, 95),
            P99CloudLatencyMs = percentile(CloudLatencyMs, 99),
            MaxCloudLatencyMs = max(CloudLatencyMs);
    let PhysicalGaps =
        RawRun
        | sort by drone_id asc, eh_sequence_number asc
        | extend
            PrevDrone = prev(drone_id),
            PrevEhTime = prev(eh_enqueued_time)
        | where drone_id == PrevDrone
        | extend
            PhysicalGapMs = datetime_diff("millisecond", eh_enqueued_time, PrevEhTime);
    let MaxPhysicalGapMs = toscalar(PhysicalGaps | summarize max(PhysicalGapMs));
    let BurstStats =
        RawRun
        | summarize 
            BurstEvents = count (),
            FirstSourceSeq = min(source_sequence_number),
            LastSourceSeq = max(source_sequence_number)
        by drone_id, EhSecond = bin(eh_enqueued_time, 1s)
        | top 1 by BurstEvents desc;
    let MaxBurstEvents = toscalar (BurstStats | project BurstEvents);
    let BurstDrone = toscalar (BurstStats | project drone_id);
    let BurstFirstSeq = toscalar(BurstStats | project FirstSourceSeq);
    let BurstLastSeq = toscalar (BurstStats | project LastSourceSeq);
    DelayStats
    | extend
        RunId = p_RunId,
        MaxPhysicalGapMs = MaxPhysicalGapMs,
        MaxBurstEvents = MaxBurstEvents,
        BurstDrone = BurstDrone,
        BurstFirstSeq = BurstFirstSeq,
        BurstLastSeq = BurstLastSeq
    | project 
        RunId, Events, P50RelativeDelayMs, P95RelativeDelayMs, P99RelativeDelayMs, MaxRelativeDelayMs, MaxPhysicalGapMs, MaxBurstEvents,
        BurstDrone, BurstFirstSeq, BurstLastSeq, P50CloudLatencyMs, P95CloudLatencyMs, P99CloudLatencyMs, MaxCloudLatencyMs
}

.create-or-alter function with (
    folder = "Gold/Serving", 
    docstring = "Integrity diagnostics for the most recently observed simulator run", 
    skipvalidation = "true") 
CurrentStreamIntegrityReport() {
    let RunId = toscalar (LatestObservedRun() | project RunId);
    StreamIntegrityReport(RunId)
}

.create-or-alter function 
with (
    folder = "Gold/Serving", 
    docstring = "Timeliness diagnostics for the most recently observed simulator run", 
    skipvalidation = "true") 
CurrentStreamTimelinessReport() {
    let RunId = toscalar (LatestObservedRun() | project RunId);
    StreamTimelinessReport(RunId)
}
